{
  "_comment": [
    "Run tests for .github/workflows/mpas_ci.yml. The plan job reads this file and makes the",
    "build_atmosphere matrix (every toolchain/build a test needs) and the run matrix (every test",
    "on every toolchain it lists).",
    "toolchains: container image, make target and MPI launcher for each compiler suite.",
    "builds:     atmosphere_model builds; repo/ref empty = the commit under test.",
    "tests:      case = run config in cases/, ics = IC case made by the ics job, bl/ft = builds",
    "            for the baseline and feature runs, nml_bl/nml_ft = namelist.atmosphere.<suffix>",
    "            ('' = the case's namelist.atmosphere), stoch = feature run uses stochastic",
    "            physics (nam_stochy is removed for the baseline), toolchains = where it runs.",
    "oneapi runs Release tests without stochastic physics for now: the intel make target has no",
    "LAPACK_LIBS and the oneapi image has no MKL."
  ],
  "toolchains": {
    "gnu":    { "image": "dustinswales/ufs-community-mpas-ci:gnu",    "make_target": "gfortran", "mpirun": "mpiexec --allow-run-as-root -np" },
    "oneapi": { "image": "dustinswales/ufs-community-mpas-ci:oneapi", "make_target": "intel",    "mpirun": "mpiexec -np" }
  },
  "builds": {
    "feature-release":       { "repo": "",                         "ref": "",             "make_flags": "" },
    "feature-debug":         { "repo": "",                         "ref": "",             "make_flags": "DEBUG=true" },
    "feature-stoch-release": { "repo": "",                         "ref": "",             "make_flags": "STOCHASTIC_PHYSICS=true" },
    "develop-release":       { "repo": "ufs-community/MPAS-Model", "ref": "noaa/develop", "make_flags": "" },
    "develop-debug":         { "repo": "ufs-community/MPAS-Model", "ref": "noaa/develop", "make_flags": "DEBUG=true" },
    "v8.4.2-release":        { "repo": "MPAS-Dev/MPAS-Model",      "ref": "v8.4.2",       "make_flags": "" },
    "v8.4.2-debug":          { "repo": "MPAS-Dev/MPAS-Model",      "ref": "v8.4.2",       "make_flags": "DEBUG=true" }
  },
  "tests": [
    { "test": "mesoscale_reference.v8.4.2.release",          "case": "mpasdev.mesoscale_reference.gfs.winter",            "ics": "conus_gfs_noahmp", "bl": "v8.4.2-release",  "ft": "feature-release",       "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "convection_permitting.v8.4.2.release",        "case": "mpasdev.convection_permitting.gfs.winter",          "ics": "conus_gfs_noahmp", "bl": "v8.4.2-release",  "ft": "feature-release",       "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "mesoscale_reference_noahmp.v8.4.2.release",   "case": "mpasdev.mesoscale_reference_noahmp.gfs.winter",     "ics": "conus_gfs_noahmp", "bl": "v8.4.2-release",  "ft": "feature-release",       "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "mesoscale_reference.develop.release",         "case": "mpasdev.mesoscale_reference.gfs.winter",            "ics": "conus_gfs_noahmp", "bl": "develop-release", "ft": "feature-release",       "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "convection_permitting.develop.release",       "case": "mpasdev.convection_permitting.gfs.winter",          "ics": "conus_gfs_noahmp", "bl": "develop-release", "ft": "feature-release",       "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "mesoscale_reference_noahmp.develop.release",  "case": "mpasdev.mesoscale_reference_noahmp.gfs.winter",     "ics": "conus_gfs_noahmp", "bl": "develop-release", "ft": "feature-release",       "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "mesoscale_reference.v8.4.2.debug",            "case": "mpasdev.mesoscale_reference.gfs.winter",            "ics": "conus_gfs_noahmp", "bl": "v8.4.2-debug",    "ft": "feature-debug",         "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "convection_permitting.v8.4.2.debug",          "case": "mpasdev.convection_permitting.gfs.winter",          "ics": "conus_gfs_noahmp", "bl": "v8.4.2-debug",    "ft": "feature-debug",         "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "mesoscale_reference_noahmp.v8.4.2.debug",     "case": "mpasdev.mesoscale_reference_noahmp.gfs.winter",     "ics": "conus_gfs_noahmp", "bl": "v8.4.2-debug",    "ft": "feature-debug",         "nml_bl": "ncar", "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "mesoscale_reference.develop.debug",           "case": "mpasdev.mesoscale_reference.gfs.winter",            "ics": "conus_gfs_noahmp", "bl": "develop-debug",   "ft": "feature-debug",         "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "convection_permitting.develop.debug",         "case": "mpasdev.convection_permitting.gfs.winter",          "ics": "conus_gfs_noahmp", "bl": "develop-debug",   "ft": "feature-debug",         "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "mesoscale_reference_noahmp.develop.debug",    "case": "mpasdev.mesoscale_reference_noahmp.gfs.winter",     "ics": "conus_gfs_noahmp", "bl": "develop-debug",   "ft": "feature-debug",         "nml_bl": "gsl",  "nml_ft": "gsl", "stoch": false, "toolchains": ["gnu"] },
    { "test": "hrrrv5.gfs.develop.release",                  "case": "ufscommunity.hrrrv5.gfs.winter",                    "ics": "conus_gfs",        "bl": "develop-release", "ft": "feature-release",       "nml_bl": "",     "nml_ft": "",    "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "hrrrv5.rap.develop.release",                  "case": "ufscommunity.hrrrv5.rap.summer",                    "ics": "conus_raps",       "bl": "develop-release", "ft": "feature-release",       "nml_bl": "",     "nml_ft": "",    "stoch": false, "toolchains": ["gnu", "oneapi"] },
    { "test": "convection_permitting.stoch.develop.release", "case": "ufscommunity.convection_permitting.gfs.winter.stoch", "ics": "conus_gfs",      "bl": "develop-release", "ft": "feature-stoch-release", "nml_bl": "",     "nml_ft": "",    "stoch": true,  "toolchains": ["gnu"] },
    { "test": "hrrrv5.stoch.develop.release",                "case": "ufscommunity.hrrrv5.gfs.winter.stoch",              "ics": "conus_gfs",        "bl": "develop-release", "ft": "feature-stoch-release", "nml_bl": "",     "nml_ft": "",    "stoch": true,  "toolchains": ["gnu"] }
  ]
}
