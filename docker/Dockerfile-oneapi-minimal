FROM ubuntu:24.04

ARG ONEAPI_VERSION='2025.3'

# Extend and update the package registry
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get --yes install --no-install-recommends \
      ca-certificates \
      curl \
      wget \
      gpg \
      binutils \
      g++ \
      gcc \
      gfortran \
      libc-dev \
      make \
      cmake \
      git \
      ksh \
      m4 \
      tcsh \
      time \
      vim \
      gh \
      jq
# See https://www.intel.com/content/www/us/en/docs/oneapi/installation-guide-linux/2025-2/hpc-apt.html

RUN wget -O - https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
     | gpg --dearmor \
     | tee /usr/share/keyrings/oneapi-archive-keyring.gpg > /dev/null \
 && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
     |  tee /etc/apt/sources.list.d/oneAPI.list \
 && apt-get update \
 && apt-get install --yes --no-install-recommends \
     intel-oneapi-common-vars \
     intel-oneapi-compiler-fortran-${ONEAPI_VERSION} \
     intel-oneapi-mpi \
     intel-oneapi-mpi-devel\
     intel-oneapi-compiler-dpcpp-cpp-${ONEAPI_VERSION} \
 && rm -rf /var/lib/apt/lists/*

# oneAPI environment. ("RUN . setvars.sh" would only affect that one build step, so set
# what the compilers and Intel MPI need explicitly.) Do not put the Intel MPI include and
# lib directories on CPATH/LIBRARY_PATH: the plain compilers would then pass configure
# checks meant for MPI compilers (PnetCDF enables its C++/Fortran APIs with icpx/ifx and
# fails to link). The mpi* wrappers add those paths themselves.
ENV I_MPI_ROOT=/opt/intel/oneapi/mpi/latest
ENV PATH="${I_MPI_ROOT}/bin:/opt/intel/oneapi/compiler/latest/bin:${PATH}"
ENV LD_LIBRARY_PATH="${I_MPI_ROOT}/lib:${I_MPI_ROOT}/opt/mpi/libfabric/lib:/opt/intel/oneapi/compiler/latest/lib:${LD_LIBRARY_PATH}"
ENV FI_PROVIDER_PATH="${I_MPI_ROOT}/opt/mpi/libfabric/lib/prov"

# Make the generic Intel MPI wrappers (mpicc, mpicxx, mpifort, mpif90) use the oneAPI
# compilers instead of GNU; MPAS's "make intel" target calls these.
ENV I_MPI_CC=icx I_MPI_CXX=icpx I_MPI_FC=ifx I_MPI_F77=ifx I_MPI_F90=ifx

# Intel MPI has no mpifort or mpic++ wrapper, and "make intel" calls both. Without these,
# they resolve to Open MPI's (installed with NetCDF in a later layer), which use GNU compilers
# and Open MPI. /usr/local/bin comes before /usr/bin on PATH.
RUN printf '#!/bin/sh\nexec /opt/intel/oneapi/mpi/latest/bin/mpif90 "$@"\n' > /usr/local/bin/mpifort \
 && printf '#!/bin/sh\nexec /opt/intel/oneapi/mpi/latest/bin/mpicxx "$@"\n' > /usr/local/bin/mpic++ \
 && chmod +x /usr/local/bin/mpifort /usr/local/bin/mpic++

# Single-node runs in a container: shared memory only, and launch ranks without ssh.
ENV I_MPI_FABRICS=shm I_MPI_HYDRA_BOOTSTRAP=fork

ENV FC=ifx CC=icx CXX=icpx
ENV MPICC=/opt/intel/oneapi/mpi/latest/bin/mpiicx
